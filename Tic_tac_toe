import random

board = ['1', '2', '3',
         '4', '5', '6',
         '7', '8', '9']

player = 'X'


def display_board():
    print()
    print(board[0] + " | " + board[1] + " | " + board[2])
    print("--+---+--")
    print(board[3] + " | " + board[4] + " | " + board[5])
    print("--+---+--")
    print(board[6] + " | " + board[7] + " | " + board[8])
    print()


def check_winner():
    winning_positions = [
        (0, 1, 2),
        (3, 4, 5),
        (6, 7, 8),
        (0, 3, 6),
        (1, 4, 7),
        (2, 5, 8),
        (0, 4, 8),
        (2, 4, 6)
    ]

    for a, b, c in winning_positions:
        if board[a] == board[b] == board[c]:
            return True

    return False


for turn in range(9):
    display_board()

    if player == 'X':
        print("Your turn")

        while True:
            try:
                position = int(input("Enter position (1-9): "))

                if position < 1 or position > 9:
                    print("Invalid position! Enter a number from 1 to 9.")
                elif board[position - 1] in ['X', 'O']:
                    print("Position already occupied! Choose another.")
                else:
                    break

            except ValueError:
                print("Please enter a valid number.")

        board[position - 1] = 'X'

    else:
        print("Computer's turn")

        available_positions = []

        for i in range(9):
            if board[i] not in ['X', 'O']:
                available_positions.append(i)

        position = random.choice(available_positions)
        board[position] = 'O'

    if check_winner():
        display_board()

        if player == 'X':
            print("You win!")
        else:
            print("Computer wins!")

        break

    if player == 'X':
        player = 'O'
    else:
        player = 'X'

else:
    display_board()
    print("It's a draw!")
